	IF INT32==0
; Copyright 1987 Manx Software Systems, Inc
; :ts=8
	blanks	off
	public	_lmemset

;	void *lmemset(void *s, int c, u_long n);
_lmemset:
	move.w	4+4(sp),d1	d1 := c
	move.l	4+6(sp),d2	d2 := n
	move.l	4+0(sp),a0	a0 := s
	move.l	a0,d0		lmemset() returns s
	bra	.2
.1
	move.b	d1,(a0)+
.2
	dbra	d2,.1
;	IF INT32
	sub.l	#$10000,d2
	bpl	.1
;	ENDC
	rts
	ENDC
