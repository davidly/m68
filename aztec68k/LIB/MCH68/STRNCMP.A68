; :ts=8
	public _strncmp
;
;	int strncmp(const char *s1, const char *s2, size_t n);
_strncmp
	movem.l	4+0(sp),a0/a1	a0 = s1; a1 = s2;
	cmp.l	a0,a1
	beq	equalstr
	IF INT32
	move.l	4+8(sp),d1
	bpl	.plus
	move.l	#$7fffffff,d1
.plus
	beq	equalstr
	sub.l	#1,d1
	ELSE
	move.w	4+8(sp),d1
	beq	equalstr
	sub.w	#1,d1
	ENDC
cmploop:
	move.b	(a0)+,d0
	cmp.b	(a1)+,d0
	bne	notequal
	tst.b	d0
	dbeq	d1,cmploop	loop until end of string OR n compares made
	IF INT32
	sub.l	#$10000,d1
	bpl	cmploop
	ENDC
equalstr:
	move.l	#0,d0
	rts
notequal:
	sub.b	-(a1),d0
	ext.w	d0
	IF INT32
	ext.l	d0
	ENDC
	rts
