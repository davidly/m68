	public	.Fadd
.Fadd:
	movem.l	d2/d3,-(sp)
	move.l	d1,d2
	jsr	.ftod#
	exg	d0,d2
	move.l	d1,d3
	jsr	.ftod#
	jsr	.Padd#
	jsr	.dtof#
	movem.l	(sp)+,d2/d3
	rts

	public	.Fcmp
.Fcmp:
	movem.l	d2/d3,-(sp)
	move.l	d0,d2
