	public _peekl
_peekl
	move.l	4(sp),a0
	btst.b	#0,7(sp)
	bne	1$
	move.l	(a0),d0
	rts
1$
	move.l	#0,d0
	move.w	#3,d1
2$
	lsl.l	#8,d0
	move.b	(a0)+,d0
	dbra	d1,2$
	rts
;
	public _peekw
_peekw
	move.l	#0,d0
	move.l	4(sp),a0
	btst.b	#0,7(sp)
	bne	1$
	move.w	(a0),d0
	rts
1$
	move.b	(a0)+,d0
	lsl.w	#8,d0
	move.b	(a0),d0
	rts
